#version 460
#extension GL_EXT_ray_query : require
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Results { uvec2 results[]; };
void main() {
    uvec2 id=gl_GlobalInvocationID.xy;
    vec2 p=(vec2(id)+0.5)/16.0*4.0-2.0;
    rayQueryEXT query;
    rayQueryInitializeEXT(query,scene,gl_RayFlagsOpaqueEXT,255,vec3(p,0),0.001,vec3(0,0,1),10.0);
    while(rayQueryProceedEXT(query)) {}
    bool hit=rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    results[id.y*16+id.x]=uvec2(hit?1:0,hit?floatBitsToUint(rayQueryGetIntersectionTEXT(query,true)):0);
}
