cmake_minimum_required(VERSION 3.25)

# This script is invoked with an argv array, never through a command shell.
# Only finalize mode changes binaries, and it accepts a fresh package staging tree.
foreach(required JENGINE_PACKAGE_PLAN JENGINE_PACKAGE_MODE)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing ${required}")
  endif()
endforeach()
file(READ "${JENGINE_PACKAGE_PLAN}" plan)

function(json_array object key output)
  string(JSON count LENGTH "${object}" "${key}")
  set(values)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON value GET "${object}" "${key}" ${index})
      if(value MATCHES "[;\r\n]")
        message(FATAL_ERROR "Runtime dependency paths cannot contain semicolons or newlines: ${value}")
      endif()
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

if(WIN32)
  # A GUI launched outside a VS developer shell still needs a PE inspector.
  find_program(pe_inspector NAMES dumpbin.exe)
  if(NOT pe_inspector)
    set(vswhere "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer/vswhere.exe")
    if(EXISTS "${vswhere}")
      execute_process(COMMAND "${vswhere}" -latest -products "*"
        -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
        -property installationPath OUTPUT_VARIABLE vs OUTPUT_STRIP_TRAILING_WHITESPACE)
      file(GLOB inspectors "${vs}/VC/Tools/MSVC/*/bin/Hostx64/x64/dumpbin.exe")
      list(SORT inspectors COMPARE NATURAL ORDER DESCENDING)
      if(inspectors)
        list(GET inspectors 0 pe_inspector)
      endif()
    endif()
  endif()
  if(NOT pe_inspector)
    message(FATAL_ERROR "Install Visual Studio x64 C++ tools (dumpbin) before packaging")
  endif()
  set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
  set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
  set(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND "${pe_inspector}")
endif()

function(collect executables modules directories output)
  set(extra)
  if(APPLE)
    list(APPEND extra PRE_EXCLUDE_REGEXES "^/System/Library/" "^/usr/lib/")
  elseif(WIN32)
    # API sets and OS DLLs come from Windows. The VC runtime is deliberately
    # included even when the development machine installed it in System32.
    list(APPEND extra PRE_EXCLUDE_REGEXES "[Aa][Pp][Ii]-[Mm][Ss]-" "[Ee][Xx][Tt]-[Mm][Ss]-")
    list(APPEND extra POST_INCLUDE_REGEXES
      ".*[/\\\\]([Mm][Ss][Vv][Cc][Pp]|[Vv][Cc][Rr][Uu][Nn][Tt][Ii][Mm][Ee]|[Cc][Oo][Nn][Cc][Rr][Tt]|[Vv][Cc][Oo][Mm][Pp])[0-9].*\\.[Dd][Ll][Ll]$")
    list(APPEND extra POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\]([Ss][Yy][Ss][Tt][Ee][Mm]32|[Ss][Yy][Ss][Ww][Oo][Ww]64)[/\\\\].*")
  else()
    message(FATAL_ERROR "Portable jEngine packaging currently supports Windows and macOS")
  endif()
  file(GET_RUNTIME_DEPENDENCIES EXECUTABLES ${executables} MODULES ${modules}
    DIRECTORIES ${directories} RESOLVED_DEPENDENCIES_VAR resolved
    UNRESOLVED_DEPENDENCIES_VAR unresolved CONFLICTING_DEPENDENCIES_PREFIX conflict ${extra})
  if(unresolved)
    message(FATAL_ERROR "Unresolved runtime libraries: ${unresolved}. Install the matching dependencies or repair the development build before packaging")
  endif()
  if(conflict_FILENAMES)
    message(FATAL_ERROR "Conflicting runtime library names: ${conflict_FILENAMES}")
  endif()
  set(${output} "${resolved}" PARENT_SCOPE)
endfunction()

function(json_quote value output)
  string(REPLACE "\\" "\\\\" text "${value}")
  string(REPLACE "\"" "\\\"" text "${text}")
  set(${output} "\"${text}\"" PARENT_SCOPE)
endfunction()

if(JENGINE_PACKAGE_MODE STREQUAL "collect")
  if(NOT DEFINED JENGINE_PACKAGE_RESULT)
    message(FATAL_ERROR "Missing dependency result path")
  endif()
  json_array("${plan}" executables executables)
  json_array("${plan}" modules modules)
  json_array("${plan}" directories directories)
  collect("${executables}" "${modules}" "${directories}" resolved)
  set(result "{\"resolved\":[]}")
  set(index 0)
  foreach(library IN LISTS resolved)
    json_quote("${library}" quoted)
    string(JSON result SET "${result}" resolved ${index} "${quoted}")
    math(EXPR index "${index} + 1")
  endforeach()
  file(WRITE "${JENGINE_PACKAGE_RESULT}" "${result}\n")
  return()
endif()

if(NOT JENGINE_PACKAGE_MODE STREQUAL "finalize" OR NOT DEFINED JENGINE_PACKAGE_STAGE)
  message(FATAL_ERROR "Expected collect or finalize with a staging root")
endif()
file(REAL_PATH "${JENGINE_PACKAGE_STAGE}" stage)
if(NOT IS_DIRECTORY "${stage}" OR IS_SYMLINK "${JENGINE_PACKAGE_STAGE}")
  message(FATAL_ERROR "Invalid package staging directory")
endif()
function(staged relative output)
  if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)" OR relative MATCHES "[;\r\n]")
    message(FATAL_ERROR "Unsafe staged runtime path: ${relative}")
  endif()
  set(path "${stage}/${relative}")
  if(NOT EXISTS "${path}" OR IS_SYMLINK "${path}" OR IS_DIRECTORY "${path}")
    message(FATAL_ERROR "Missing or symlink staged runtime file: ${relative}")
  endif()
  file(REAL_PATH "${path}" real)
  cmake_path(IS_PREFIX stage "${real}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR "Staged runtime path escapes package: ${relative}")
  endif()
  set(${output} "${real}" PARENT_SCOPE)
endfunction()
function(run_tool)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Runtime fixup command failed (${status}): ${ARGV}\n${stdout}\n${stderr}")
  endif()
endfunction()

json_array("${plan}" executableDestinations executable_destinations)
json_array("${plan}" moduleDestinations module_destinations)
json_array("${plan}" launchers launchers)
set(executables)
set(modules)
foreach(relative IN LISTS executable_destinations)
  staged("${relative}" path)
  list(APPEND executables "${path}")
endforeach()
foreach(relative IN LISTS module_destinations)
  staged("${relative}" path)
  list(APPEND modules "${path}")
endforeach()
string(JSON library_count LENGTH "${plan}" libraries)
set(library_destinations)
if(library_count GREATER 0)
  math(EXPR library_last "${library_count} - 1")
  foreach(index RANGE 0 ${library_last})
    string(JSON relative GET "${plan}" libraries ${index} destination)
    staged("${relative}" path)
    list(APPEND library_destinations "${path}")
  endforeach()
endif()

if(APPLE)
  find_program(install_name_tool NAMES install_name_tool REQUIRED)
  find_program(otool NAMES otool REQUIRED)
  find_program(codesign NAMES codesign REQUIRED)
  # Libraries first, then their executables. Nothing under the source/toolchain
  # directories is touched; all tool targets pass staged() above.
  set(binaries ${library_destinations} ${executables})
  list(REMOVE_DUPLICATES binaries)
  foreach(binary IN LISTS binaries)
    file(CHMOD "${binary}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
    execute_process(COMMAND "${otool}" -L "${binary}" RESULT_VARIABLE status OUTPUT_VARIABLE load_commands ERROR_VARIABLE errors)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot inspect staged Mach-O: ${binary}\n${errors}")
    endif()
    execute_process(COMMAND "${otool}" -D "${binary}" OUTPUT_VARIABLE identity ERROR_QUIET)
    string(REPLACE "\n" ";" identity_lines "${identity}")
    list(LENGTH identity_lines identity_count)
    set(old_identity "")
    if(identity_count GREATER 1)
      list(GET identity_lines 1 old_identity)
      string(STRIP "${old_identity}" old_identity)
    endif()
    string(REPLACE "\n" ";" lines "${load_commands}")
    foreach(line IN LISTS lines)
      if(NOT line MATCHES "^[ \t]+(.+) \\(compatibility version")
        continue()
      endif()
      set(dependency "${CMAKE_MATCH_1}")
      if(dependency STREQUAL old_identity OR dependency MATCHES "^/System/Library/" OR dependency MATCHES "^/usr/lib/")
        continue()
      endif()
      get_filename_component(name "${dependency}" NAME)
      set(destination "")
      if(IS_ABSOLUTE "${dependency}" AND EXISTS "${dependency}")
        file(REAL_PATH "${dependency}" real_dependency)
      else()
        set(real_dependency "")
      endif()
      if(library_count GREATER 0)
        foreach(index RANGE 0 ${library_last})
          string(JSON library GET "${plan}" libraries ${index})
          string(JSON source GET "${library}" source)
          string(JSON candidate GET "${library}" destination)
          json_array("${library}" aliases aliases)
          if(real_dependency STREQUAL source OR name IN_LIST aliases)
            if(destination AND NOT destination STREQUAL candidate)
              message(FATAL_ERROR "Ambiguous relocated library: ${dependency}")
            endif()
            set(destination "${candidate}")
          endif()
        endforeach()
      endif()
      if(NOT destination)
        message(FATAL_ERROR "No packaged library mapping for ${dependency} used by ${binary}")
      endif()
      get_filename_component(loader_directory "${binary}" DIRECTORY)
      file(RELATIVE_PATH relative_dependency "${loader_directory}" "${stage}/${destination}")
      run_tool("${install_name_tool}" -change "${dependency}" "@loader_path/${relative_dependency}" "${binary}")
    endforeach()
    if(binary IN_LIST library_destinations)
      get_filename_component(name "${binary}" NAME)
      run_tool("${install_name_tool}" -id "@rpath/${name}" "${binary}")
    endif()
    execute_process(COMMAND "${otool}" -l "${binary}" OUTPUT_VARIABLE commands RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot inspect Mach-O rpaths: ${binary}")
    endif()
    string(REGEX MATCHALL "cmd LC_RPATH\n[^\n]*\n[ \t]*path [^\n]+" rpaths "${commands}")
    foreach(block IN LISTS rpaths)
      string(REGEX REPLACE ".*\n[ \t]*path (.+) \\(offset [0-9]+\\).*" "\\1" rpath "${block}")
      run_tool("${install_name_tool}" -delete_rpath "${rpath}" "${binary}")
    endforeach()
    get_filename_component(directory "${binary}" DIRECTORY)
    file(RELATIVE_PATH relative_lib "${directory}" "${stage}/runtime/lib")
    if(relative_lib STREQUAL "")
      set(loader_path "@loader_path")
    else()
      set(loader_path "@loader_path/${relative_lib}")
    endif()
    run_tool("${install_name_tool}" -add_rpath "${loader_path}" "${binary}")
    run_tool("${codesign}" --force --sign - --timestamp=none "${binary}")
    run_tool("${codesign}" --verify --strict "${binary}")
  endforeach()
endif()

foreach(relative IN LISTS launchers)
  staged("${relative}" launcher)
  if(UNIX)
    file(CHMOD "${launcher}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endif()
endforeach()
collect("${executables}" "${modules}" "${stage}/runtime;${stage}/runtime/lib;${stage}/runtime/D3D12" resolved)
foreach(library IN LISTS resolved)
  file(REAL_PATH "${library}" real)
  cmake_path(IS_PREFIX stage "${real}" NORMALIZE inside)
  if(NOT inside)
    message(FATAL_ERROR "Package still resolves a development-machine library: ${library}")
  endif()
endforeach()
message(STATUS "Staged runtime closure verified; hashes may now be computed")
